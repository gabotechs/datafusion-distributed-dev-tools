#!/usr/bin/env bash
set -euo pipefail

source /usr/local/libexec/datafusion-pr-bot/cache-paths
umask 0007
target=${1:?target cache is required}
cargo_home=${2:?Cargo home is required}
seed_target=${3:-}
seed_cargo_home=${4:-}

copy_seed() {
  local seed=$1 destination=$2
  [[ -n ${seed} && -d ${seed} && ! -e ${destination} ]] || return 0
  runuser --user benchmark-build --group benchmark-cache -- mkdir --parents "${destination}"
  runuser --user benchmark-build --group benchmark-cache -- \
    cp --archive --reflink=auto "${seed}/." "${destination}/"
}

validate_cache_path "${target}"
validate_cache_path "${cargo_home}"
[[ -z ${seed_target} ]] || validate_cache_path "${seed_target}"
[[ -z ${seed_cargo_home} ]] || validate_cache_path "${seed_cargo_home}"

copy_seed "${seed_target}" "${target}"
copy_seed "${seed_cargo_home}" "${cargo_home}"
runuser --user benchmark-build --group benchmark-cache -- \
  mkdir --parents "${target}" "${cargo_home}"
runuser --user benchmark-build --group benchmark-cache -- \
  touch "${target}" "${cargo_home}"
