{
  "name": "datafusion-distributed-pr-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "controller-deploy": "npm run pulumi:build && pulumi up",
    "controller-destroy": "pulumi destroy",
    "controller-outputs": "pulumi stack output --json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "tsx src/main.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "pulumi:build": "tsc --project tsconfig.pulumi.json"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@pulumi/aws": "^7.41.0",
    "@pulumi/pulumi": "^3.256.0"
  }
}
