{
  "name": "datafusion-distributed-dev-tools",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix pr-bot install && npm --prefix benchmarks-remote install",
    "build": "npm --prefix pr-bot run build && npm --prefix benchmarks-remote run build",
    "test": "npm run format:check && npm run lint && npm --prefix pr-bot test && npm --prefix benchmarks-remote test",
    "lint": "eslint .",
    "format": "prettier --write package.json tsconfig.base.json eslint.config.mjs .github README.md AGENTS.md && npm --prefix pr-bot run format && npm --prefix benchmarks-remote run format",
    "format:check": "prettier --check package.json tsconfig.base.json eslint.config.mjs .github README.md AGENTS.md && npm --prefix pr-bot run format:check && npm --prefix benchmarks-remote run format:check",
    "controller-deploy": "npm --prefix pr-bot run controller-deploy",
    "controller-destroy": "npm --prefix pr-bot run controller-destroy",
    "controller-outputs": "npm --prefix pr-bot run controller-outputs",
    "controller-ssh": "npm --prefix pr-bot run controller-ssh",
    "foundation-deploy": "npm --prefix benchmarks-remote run foundation-deploy",
    "foundation-destroy": "npm --prefix benchmarks-remote run foundation-destroy",
    "sync-bucket": "npm --prefix benchmarks-remote run sync-bucket --",
    "dataset-destroy": "npm --prefix benchmarks-remote run dataset-destroy --",
    "compare": "npm --prefix benchmarks-remote run compare --",
    "datafusion-deploy": "npm --prefix benchmarks-remote run datafusion-deploy",
    "datafusion-destroy": "npm --prefix benchmarks-remote run datafusion-destroy",
    "datafusion-bench": "npm --prefix benchmarks-remote run datafusion-bench --",
    "trino-deploy": "npm --prefix benchmarks-remote run trino-deploy",
    "trino-destroy": "npm --prefix benchmarks-remote run trino-destroy",
    "trino-bench": "npm --prefix benchmarks-remote run trino-bench --",
    "spark-deploy": "npm --prefix benchmarks-remote run spark-deploy",
    "spark-destroy": "npm --prefix benchmarks-remote run spark-destroy",
    "spark-bench": "npm --prefix benchmarks-remote run spark-bench --",
    "ballista-deploy": "npm --prefix benchmarks-remote run ballista-deploy",
    "ballista-destroy": "npm --prefix benchmarks-remote run ballista-destroy",
    "ballista-bench": "npm --prefix benchmarks-remote run ballista-bench --",
    "command": "npm --prefix benchmarks-remote run command --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^16.4.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
