{
  "name": "datafusion-distributed-dev-tools",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "install:all": "npm install && npm --prefix benchmark-bot install && npm --prefix benchmarks-remote install",
    "build": "npm --prefix benchmark-bot run build && npm --prefix benchmarks-remote run build",
    "test": "npm run format:check && npm run lint && npm --prefix benchmark-bot test && npm --prefix benchmarks-remote test",
    "lint": "eslint .",
    "format": "prettier --write package.json tsconfig.base.json eslint.config.mjs .github README.md AGENTS.md && npm --prefix benchmark-bot run format && npm --prefix benchmarks-remote run format",
    "format:check": "prettier --check package.json tsconfig.base.json eslint.config.mjs .github README.md AGENTS.md && npm --prefix benchmark-bot run format:check && npm --prefix benchmarks-remote run format:check",
    "bot-deploy": "npm --prefix benchmark-bot run bot-deploy --",
    "bot-destroy": "npm --prefix benchmark-bot run bot-destroy --",
    "bot-outputs": "npm --prefix benchmark-bot run bot-outputs --",
    "bot-session": "npm --prefix benchmark-bot run bot-session --",
    "foundation-deploy": "npm --prefix benchmarks-remote run -s foundation-deploy --",
    "foundation-destroy": "npm --prefix benchmarks-remote run -s foundation-destroy --",
    "list-datasets": "npm --prefix benchmarks-remote run -s list-datasets --",
    "compare": "npm --prefix benchmarks-remote run -s compare --",
    "datafusion-deploy": "npm --prefix benchmarks-remote run -s datafusion-deploy --",
    "datafusion-destroy": "npm --prefix benchmarks-remote run -s datafusion-destroy --",
    "datafusion-bench": "npm --prefix benchmarks-remote run -s datafusion-bench --",
    "trino-deploy": "npm --prefix benchmarks-remote run -s trino-deploy --",
    "trino-destroy": "npm --prefix benchmarks-remote run -s trino-destroy --",
    "trino-bench": "npm --prefix benchmarks-remote run -s trino-bench --",
    "spark-deploy": "npm --prefix benchmarks-remote run -s spark-deploy --",
    "spark-destroy": "npm --prefix benchmarks-remote run -s spark-destroy --",
    "spark-bench": "npm --prefix benchmarks-remote run -s spark-bench --",
    "ballista-deploy": "npm --prefix benchmarks-remote run -s ballista-deploy --",
    "ballista-destroy": "npm --prefix benchmarks-remote run -s ballista-destroy --",
    "ballista-bench": "npm --prefix benchmarks-remote run -s ballista-bench --",
    "command": "npm --prefix benchmarks-remote run -s command --",
    "clickhouse-deploy": "npm --prefix benchmarks-remote run -s clickhouse-deploy --",
    "clickhouse-destroy": "npm --prefix benchmarks-remote run -s clickhouse-destroy --",
    "clickhouse-bench": "npm --prefix benchmarks-remote run -s clickhouse-bench --",
    "sum-tasks": "npm --prefix benchmarks-remote run -s sum-tasks --",
    "publish-datafusion": "npm --prefix benchmarks-remote run -s publish-datafusion --",
    "publish-ballista": "npm --prefix benchmarks-remote run -s publish-ballista --",
    "publish-image": "npm --prefix benchmarks-remote run -s publish-image --",
    "install-tenancy": "npm --prefix benchmarks-remote run -s install-tenancy --",
    "test-render": "npm --prefix benchmarks-remote run -s test-render --"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^16.4.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
