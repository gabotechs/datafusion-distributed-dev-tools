{
  "name": "datafusion-distributed-remote-benchmarks",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "pulumi"
  ],
  "scripts": {
    "build": "tsc --noEmit && npm --workspace pulumi run build",
    "application:build": "esbuild src/bin/datafusion-bench.ts src/bin/compare.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist --out-extension:.js=.cjs",
    "test": "tsx --test test/*.test.ts && npm --workspace pulumi test",
    "format": "prettier --write src test package.json tsconfig.json && npm --workspace pulumi run format",
    "format:check": "prettier --check src test package.json tsconfig.json && npm --workspace pulumi run format:check",
    "foundation-deploy": "./pulumi/deploy.sh",
    "foundation-destroy": "./pulumi/destroy.sh",
    "sync-bucket": "tsx src/bin/sync-bucket.ts",
    "dataset-destroy": "tsx src/bin/destroy-dataset.ts",
    "compare": "tsx src/bin/compare.ts",
    "datafusion-bench": "tsx src/bin/datafusion-bench.ts",
    "trino-bench": "tsx src/bin/trino-bench.ts",
    "spark-bench": "tsx src/bin/spark-bench.ts",
    "ballista-bench": "tsx src/bin/ballista-bench.ts",
    "datafusion-deploy": "bash ./k8s/deploy-engine.sh datafusion",
    "datafusion-destroy": "bash ./k8s/destroy-engine.sh datafusion",
    "trino-deploy": "bash ./k8s/deploy-engine.sh trino",
    "trino-destroy": "bash ./k8s/destroy-engine.sh trino",
    "spark-deploy": "bash ./k8s/deploy-engine.sh spark",
    "spark-destroy": "bash ./k8s/destroy-engine.sh spark",
    "ballista-deploy": "bash ./k8s/deploy-engine.sh ballista",
    "ballista-destroy": "bash ./k8s/destroy-engine.sh ballista",
    "command": "bash ./k8s/command.sh"
  },
  "dependencies": {
    "@optique/core": "^1.2.0",
    "@optique/run": "^1.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "^0.28.2",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
