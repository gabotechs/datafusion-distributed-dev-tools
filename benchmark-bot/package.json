{
  "name": "@datafusion-distributed-dev-tools/benchmark-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run pulumi:build && npm run application:build",
    "application:build": "tsc --project tsconfig.controller.json && npm --prefix ../benchmarks-remote run application:build",
    "bot-deploy": "tsx src/bin/bot-deploy.ts",
    "bot-destroy": "tsx src/bin/bot-destroy.ts",
    "bot-outputs": "tsx src/bin/bot-outputs.ts",
    "bot-session": "tsx src/bin/bot-session.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/application/src/main.js",
    "test": "node --import tsx --test test/*.test.ts",
    "pulumi:build": "tsc --project tsconfig.pulumi.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@optique/core": "^1.3.3",
    "@optique/run": "^1.3.3",
    "@pulumi/aws": "^7.41.0",
    "@pulumi/pulumi": "^3.256.0"
  }
}
