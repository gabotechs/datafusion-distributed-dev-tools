{
  "name": "@datafusion-distributed-dev-tools/benchmark-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit && npm run pulumi:build && npm run application:build",
    "application:build": "tsc --project tsconfig.controller.json && npm --prefix ../benchmarks-remote run application:build",
    "controller-deploy": "npm run application:build && npm run pulumi:build && pulumi up",
    "controller-destroy": "pulumi destroy",
    "controller-outputs": "pulumi stack output --json",
    "controller-ssh": "aws ssm start-session --target $(pulumi stack output controllerInstanceId)",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node dist/application/src/main.js",
    "test": "node --import tsx --test test/*.test.ts",
    "pulumi:build": "tsc --project tsconfig.pulumi.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@pulumi/aws": "^7.41.0",
    "@pulumi/pulumi": "^3.256.0"
  }
}
