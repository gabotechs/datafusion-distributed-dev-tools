#!/usr/bin/env bash
set -euo pipefail

source_root=${1:?source root is required}
target=${2:?target cache is required}
cargo_home=${3:?Cargo home is required}

[[ $(realpath "${source_root}") == /var/lib/datafusion-pr-bot/jobs/* ]] || {
  echo "Source is outside the job root" >&2
  exit 2
}

exec systemd-run --quiet --wait --pipe --collect \
  --property=User=benchmark-build \
  --property=Group=benchmark-build \
  --property=NoNewPrivileges=yes \
  --property=PrivateTmp=yes \
  --property=ProtectHome=yes \
  --property=ProtectSystem=strict \
  --property=ProtectKernelModules=yes \
  --property=ProtectKernelTunables=yes \
  --property=ProtectControlGroups=yes \
  --property=RestrictSUIDSGID=yes \
  --property=LockPersonality=yes \
  --property=ReadOnlyPaths="${source_root}" \
  --property=ReadWritePaths="${target}" \
  --property=ReadWritePaths="${cargo_home}" \
  --property=IPAddressDeny=any \
  --setenv=HOME=/var/lib/datafusion-pr-build \
  --setenv=CARGO_HOME="${cargo_home}" \
  --setenv=CARGO_TARGET_DIR="${target}" \
  --setenv=AWS_EC2_METADATA_DISABLED=true \
  /var/lib/datafusion-pr-build/.cargo/bin/cargo zigbuild \
  --locked \
  --offline \
  --manifest-path "${source_root}/benchmarks-remote/engines/datafusion/Cargo.toml" \
  --package datafusion-distributed-benchmark-worker \
  --release \
  --bin worker \
  --target x86_64-unknown-linux-gnu
